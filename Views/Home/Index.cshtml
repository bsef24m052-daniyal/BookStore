@model HW_5.ViewModel.HomeViewModel
<div class="display-1">
    <h1>Book Store</h1>
</div>
<div class="container">
<form method="post" action="/Home/AddBook" class="d-flex flex-row justify-content-between">
	<div class="form-group col-3">
		<label for="title">Title:</label>
		<input type="text" class="form-control" id="title" name="title" required />
	</div>
	<div class="form-group col-3 mb-1">
		<label for="price">Price:</label>
		<input type="number" class="form-control" id="price" name="price" step="0.01" required />
	</div>
	<div class="form-group col-3 mb-1">
		<label for="authorId">Author:</label>
		<select class="form-control" id="authorId" name="authorId" required>
			<option value="">Select an author</option>
			@foreach (var author in Model.Authors)
			{
				<option value="@author.Id">@author.Name</option>
			}
		</select>
	</div>
	<button type="submit" class="btn btn-primary ">Add Book</button>
</form>
</div>
<div class="container">
<form method="post" action="/Home/AddAuthor" class="d-flex flex-row justify-content-between col-9">
	<div class="form-group col-3">
		<label for="name">Name:</label>
		<input type="text" class="form-control" id="name" name="name" required />
	</div>
	<div class="form-group col-3">
		<label for="country">Country:</label>
		<input type="text" class="form-control" id="country" name="country" required />
	</div>
	<button type="submit" class="btn btn-primary">Add Author</button>
</form>		
</div>
<div class="container">
	<div class="display-1">
		<h1>Authors</h1>
	</div>
	<div class="row">
		@foreach (var author in Model.Authors)
		{
			<div class="col-md-4 mb-4">
				<div class="card h-100">
					<div class="card-body">
						<h5	 class="card-title">@author.Name</h5>
						<p class="card-text">Country: @author.Country</p>
					</div>
				</div>
			</div>
		}
	</div>
</div>
<div class="container">
	<div class="display-1">
		<h1>Books</h1>
	</div>
	@if (Model.Books.Count>0)
	{
		<div class="row">
			@foreach (var book in Model.Books)
			{
				<div class="col-md-4 mb-4">
					<div class="card h-100">
						<div class="card-body">
							<h5 class="card-title">@book.Title</h5>
							<p class="card-text">Price: $@book.Price</p>
							<p class="card-text">Author: @book.AuthorName</p>
							<form method="post" action="/Home/RemoveBook" onsubmit="return confirmRemove();">
								<input type="hidden" name="id" value="@book.Id" />
								<button type="submit" class="btn btn-danger">Remove</button></form>
						</div>
					</div>
				</div>
			}
		</div>
	}
	else
	{
		<p>No books available.</p>
	}
	
</div>

@section Styles {
	<style>
		.card {
			border: 1px solid #ccc;
			padding: 15px;
			margin: 10px;
			width: 250px;
		}
	</style>
}
@section Scripts {
	<script>
		confirmRemove = function () {
			return confirm("Are you sure you want to remove this book?");
		}
	</script>
}